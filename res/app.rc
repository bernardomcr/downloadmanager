#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

1 RT_MANIFEST "app.manifest"

IDI_APP ICON "app.ico"

// Os textos são definidos em tempo de execução (i18n); aqui só o layout, em unidades de diálogo.

IDD_ADD DIALOGEX 0, 0, 300, 118
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_URL_LABEL, 7, 7, 286, 9
    EDITTEXT        IDC_URL, 7, 17, 286, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_FOLDER_LABEL, 7, 37, 286, 9
    EDITTEXT        IDC_FOLDER, 7, 47, 230, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_BROWSE, 241, 47, 52, 14
    LTEXT           "", IDC_NAME_LABEL, 7, 67, 286, 9
    EDITTEXT        IDC_NAME, 7, 77, 286, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "", IDOK, 187, 98, 52, 14
    PUSHBUTTON      "", IDCANCEL, 241, 98, 52, 14
END

IDD_CHANGE_URL DIALOGEX 0, 0, 300, 70
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_URL_LABEL, 7, 7, 286, 18
    EDITTEXT        IDC_URL, 7, 27, 286, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "", IDOK, 187, 50, 52, 14
    PUSHBUTTON      "", IDCANCEL, 241, 50, 52, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 330, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_SET_FOLDER_LABEL, 4, 4, 300, 9
    EDITTEXT        IDC_SET_FOLDER, 4, 14, 260, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_SET_BROWSE, 268, 14, 56, 14
    LTEXT           "", IDC_SET_CONNECTIONS_LABEL, 4, 36, 300, 9
    EDITTEXT        IDC_SET_CONNECTIONS, 4, 46, 40, 14, ES_NUMBER
    CONTROL         "", IDC_SET_CONNECTIONS_SPIN, UPDOWN_CLASSW,
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    44, 46, 10, 14
    LTEXT           "", IDC_SET_LANGUAGE_LABEL, 4, 68, 300, 9
    COMBOBOX        IDC_SET_LANGUAGE, 4, 78, 150, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    AUTOCHECKBOX    "", IDC_SET_CLOSE_TO_TRAY, 4, 102, 320, 10
    AUTOCHECKBOX    "", IDC_SET_START_WITH_WINDOWS, 4, 116, 320, 10
    AUTOCHECKBOX    "", IDC_SET_NOTIFY, 4, 130, 320, 10
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION DM_VERSION_MAJOR, DM_VERSION_MINOR, DM_VERSION_PATCH, 0
PRODUCTVERSION DM_VERSION_MAJOR, DM_VERSION_MINOR, DM_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Download Manager"
            VALUE "FileVersion", DM_VERSION_STRING
            VALUE "ProductName", "Download Manager"
            VALUE "ProductVersion", DM_VERSION_STRING
            VALUE "OriginalFilename", "DownloadManager.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
