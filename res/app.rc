#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

1 RT_MANIFEST "app.manifest"

IDI_APP ICON "app.ico"

// Os textos são definidos em tempo de execução (i18n); aqui só o layout, em unidades de diálogo.

// "Adicionar" manual: link (http, https, magnet) ou .torrent.
IDD_ADD DIALOGEX 0, 0, 310, 136
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_URL_LABEL, 10, 10, 290, 9
    EDITTEXT        IDC_URL, 10, 21, 222, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_TORRENT, 236, 21, 64, 14
    LTEXT           "", IDC_FOLDER_LABEL, 10, 43, 290, 9
    EDITTEXT        IDC_FOLDER, 10, 54, 222, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_BROWSE, 236, 54, 64, 14
    LTEXT           "", IDC_RULE_HINT, 10, 71, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "", IDC_NAME_LABEL, 10, 84, 290, 9
    EDITTEXT        IDC_NAME, 10, 95, 290, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "", IDOK, 180, 116, 58, 14
    PUSHBUTTON      "", IDCANCEL, 242, 116, 58, 14
END

// Download vindo do navegador: o arquivo em destaque, o link escondido ("Mostrar link").
IDD_ADD_BROWSER DIALOGEX 0, 0, 310, 112
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            "", IDC_FILE_ICON, 10, 10, 21, 20, SS_ICON | SS_CENTERIMAGE
    EDITTEXT        IDC_NAME, 38, 10, 262, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_SOURCE, 38, 27, 190, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL         "", IDC_SHOW_LINK, "SysLink", LWS_RIGHT | WS_TABSTOP, 230, 27, 70, 9
    EDITTEXT        IDC_URL, 10, 42, 290, 14, ES_AUTOHSCROLL | ES_READONLY | NOT WS_VISIBLE
    LTEXT           "", IDC_FOLDER_LABEL, 10, 44, 290, 9
    EDITTEXT        IDC_FOLDER, 10, 55, 222, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_BROWSE, 236, 55, 64, 14
    LTEXT           "", IDC_RULE_HINT, 10, 72, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    DEFPUSHBUTTON   "", IDOK, 180, 90, 58, 14
    PUSHBUTTON      "", IDCANCEL, 242, 90, 58, 14
END

IDD_CHANGE_URL DIALOGEX 0, 0, 300, 70
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_URL_LABEL, 7, 7, 286, 18
    EDITTEXT        IDC_URL, 7, 27, 286, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "", IDOK, 187, 50, 52, 14
    PUSHBUTTON      "", IDCANCEL, 241, 50, 52, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 420, 240
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VSCROLL
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_SET_FOLDER_LABEL, 4, 4, 300, 9
    EDITTEXT        IDC_SET_FOLDER, 4, 14, 340, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_SET_BROWSE, 348, 14, 60, 14

    LTEXT           "", IDC_SET_CONNECTIONS_LABEL, 4, 38, 196, 9
    EDITTEXT        IDC_SET_CONNECTIONS, 4, 48, 40, 14, ES_NUMBER
    CONTROL         "", IDC_SET_CONNECTIONS_SPIN, UPDOWN_CLASSW,
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    44, 48, 10, 14
    LTEXT           "", IDC_SET_MAX_DOWNLOADS_LABEL, 4, 68, 196, 9
    EDITTEXT        IDC_SET_MAX_DOWNLOADS, 4, 78, 40, 14, ES_NUMBER
    CONTROL         "", IDC_SET_MAX_DOWNLOADS_SPIN, UPDOWN_CLASSW,
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    44, 78, 10, 14
    LTEXT           "", IDC_SET_SPEED_LIMIT_LABEL, 4, 98, 196, 9
    EDITTEXT        IDC_SET_SPEED_LIMIT, 4, 108, 60, 14, ES_NUMBER
    LTEXT           "", IDC_SET_LANGUAGE_LABEL, 4, 128, 196, 9
    COMBOBOX        IDC_SET_LANGUAGE, 4, 138, 150, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    AUTOCHECKBOX    "", IDC_SET_AUTO_UPDATE, 4, 160, 196, 10
    LTEXT           "", IDC_SET_VERSION, 4, 174, 136, 18
    PUSHBUTTON      "", IDC_SET_UPDATE, 144, 172, 60, 14

    AUTOCHECKBOX    "", IDC_SET_SCHEDULE, 212, 38, 100, 10
    CONTROL         "", IDC_SET_SCHEDULE_START, DATETIMEPICK_CLASSW, DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP,
                    212, 50, 46, 14
    CTEXT           "", IDC_SET_SCHEDULE_AND, 258, 53, 16, 9
    CONTROL         "", IDC_SET_SCHEDULE_END, DATETIMEPICK_CLASSW, DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP,
                    274, 50, 46, 14
    LTEXT           "", IDC_SET_WHEN_DONE_LABEL, 212, 70, 200, 9
    COMBOBOX        IDC_SET_WHEN_DONE, 212, 80, 150, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    AUTOCHECKBOX    "", IDC_SET_CLOSE_TO_TRAY, 212, 102, 204, 10
    AUTOCHECKBOX    "", IDC_SET_START_WITH_WINDOWS, 212, 116, 204, 10
    AUTOCHECKBOX    "", IDC_SET_NOTIFY, 212, 130, 204, 10
    AUTOCHECKBOX    "", IDC_SET_KEEP_AWAKE, 212, 144, 204, 10
    AUTOCHECKBOX    "", IDC_SET_BROWSER_ASK, 212, 158, 204, 10
    AUTOCHECKBOX    "", IDC_SET_ADOPT, 212, 172, 204, 10

    LTEXT           "", IDC_SET_DEBRID_TITLE, 4, 198, 404, 9
    EDITTEXT        IDC_SET_DEBRID_TOKEN, 4, 210, 200, 14, ES_AUTOHSCROLL | ES_PASSWORD
    PUSHBUTTON      "", IDC_SET_DEBRID_CONNECT, 208, 210, 60, 14
    LTEXT           "", IDC_SET_DEBRID_STATUS, 4, 228, 404, 9, SS_NOPREFIX | SS_ENDELLIPSIS
END

IDD_SPEED_LIMIT DIALOGEX 0, 0, 240, 62
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_URL_LABEL, 7, 7, 226, 18
    EDITTEXT        IDC_URL, 7, 26, 60, 14, ES_NUMBER
    DEFPUSHBUTTON   "", IDOK, 127, 42, 52, 14
    PUSHBUTTON      "", IDCANCEL, 181, 42, 52, 14
END

IDD_VIDEO DIALOGEX 0, 0, 340, 238
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_VIDEO_NAME, 7, 7, 326, 10, SS_ENDELLIPSIS | SS_NOPREFIX
    LTEXT           "", IDC_VIDEO_STATUS, 7, 21, 326, 18, SS_NOPREFIX
    CONTROL         "", IDC_VIDEO_PROGRESS, PROGRESS_CLASSW, 0, 7, 40, 326, 7
    LTEXT           "", IDC_VIDEO_QUALITY_LABEL, 7, 54, 150, 9
    COMBOBOX        IDC_VIDEO_QUALITY, 7, 64, 150, 120, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    AUTOCHECKBOX    "", IDC_VIDEO_SUBTITLES, 166, 66, 167, 10
    LTEXT           "", IDC_VIDEO_PLAYLIST_LABEL, 7, 84, 326, 9
    CONTROL         "", IDC_VIDEO_LIST, WC_LISTVIEWW, LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
                    7, 94, 326, 90
    LTEXT           "", IDC_FOLDER_LABEL, 7, 190, 326, 9
    EDITTEXT        IDC_FOLDER, 7, 200, 270, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_BROWSE, 281, 200, 52, 14
    DEFPUSHBUTTON   "", IDOK, 227, 219, 52, 14
    PUSHBUTTON      "", IDCANCEL, 281, 219, 52, 14
END

IDD_RULES DIALOGEX 0, 0, 420, 200
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX    "", IDC_RULES_ENABLED, 0, 0, 420, 10
    CONTROL         "", IDC_RULES_LIST, WC_LISTVIEWW,
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP,
                    0, 14, 420, 164
    PUSHBUTTON      "", IDC_RULE_NEW, 0, 184, 60, 14
    PUSHBUTTON      "", IDC_RULE_EDIT, 64, 184, 50, 14
    PUSHBUTTON      "", IDC_RULE_DELETE, 118, 184, 50, 14
    PUSHBUTTON      "", IDC_RULE_UP, 172, 184, 44, 14
    PUSHBUTTON      "", IDC_RULE_DOWN, 220, 184, 44, 14
    PUSHBUTTON      "", IDC_RULE_RESTORE, 340, 184, 80, 14
END

IDD_RULE_EDIT DIALOGEX 0, 0, 320, 278
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_RULE_NAME_LABEL, 7, 7, 306, 9
    EDITTEXT        IDC_RULE_NAME, 7, 17, 306, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_RULE_IF, 7, 38, 306, 10
    LTEXT           "", IDC_RULE_KIND_LABEL, 15, 52, 120, 9
    COMBOBOX        IDC_RULE_KIND, 15, 62, 140, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "", IDC_RULE_EXT_LABEL, 15, 80, 298, 9
    EDITTEXT        IDC_RULE_EXT, 15, 90, 298, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_RULE_SITES_LABEL, 15, 108, 298, 9
    EDITTEXT        IDC_RULE_SITES, 15, 118, 298, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_RULE_CONTAINS_LABEL, 15, 136, 140, 9
    EDITTEXT        IDC_RULE_CONTAINS, 15, 146, 140, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_RULE_MIN_LABEL, 163, 136, 72, 9
    EDITTEXT        IDC_RULE_MIN, 163, 146, 70, 14, ES_NUMBER
    LTEXT           "", IDC_RULE_MAX_LABEL, 241, 136, 72, 9
    EDITTEXT        IDC_RULE_MAX, 241, 146, 72, 14, ES_NUMBER
    LTEXT           "", IDC_RULE_THEN, 7, 168, 306, 10
    LTEXT           "", IDC_RULE_FOLDER_LABEL, 15, 182, 298, 9
    EDITTEXT        IDC_RULE_FOLDER, 15, 192, 240, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_RULE_BROWSE, 259, 192, 54, 14
    AUTOCHECKBOX    "", IDC_RULE_EXTRACT, 15, 212, 140, 10
    AUTOCHECKBOX    "", IDC_RULE_DELETE_ARCHIVE, 163, 212, 150, 10
    AUTOCHECKBOX    "", IDC_RULE_OPEN_FILE, 15, 226, 140, 10
    AUTOCHECKBOX    "", IDC_RULE_OPEN_FOLDER, 163, 226, 150, 10
    DEFPUSHBUTTON   "", IDOK, 207, 256, 52, 14
    PUSHBUTTON      "", IDCANCEL, 261, 256, 52, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION DM_VERSION_MAJOR, DM_VERSION_MINOR, DM_VERSION_PATCH, 0
PRODUCTVERSION DM_VERSION_MAJOR, DM_VERSION_MINOR, DM_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Download Manager"
            VALUE "FileVersion", DM_VERSION_STRING
            VALUE "ProductName", "Download Manager"
            VALUE "ProductVersion", DM_VERSION_STRING
            VALUE "OriginalFilename", "DownloadManager.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
